# Reference values only. Spring Boot does not automatically load this file.
# Set these in the PowerShell process (see README), or provide them through your deployment environment.
SERVER_PORT=8081
# For explicit dev-only password reset link logging, also bind the backend to loopback.
SERVER_ADDRESS=0.0.0.0
DB_URL=jdbc:postgresql://localhost:5432/finstack_db
DB_USERNAME=postgres
# Required: supply privately in the shell or deployment secret store; no usable value is provided here.
DB_PASSWORD=
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
# Leave SMTP unconfigured for local UI work; use the explicit development link flag only on a trusted machine.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
EMAIL_VERIFICATION_EXPIRATION_MINUTES=30
EMAIL_VERIFICATION_DEV_LOG_LINK=false
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRATION_MINUTES=30
# Development only: requires SPRING_PROFILES_ACTIVE=dev and a loopback FRONTEND_BASE_URL.
PASSWORD_RESET_DEV_LOG_LINK=false
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTION_TOPIC=finstack.transaction.events
KAFKA_FRAUD_TOPIC=finstack.fraud.results
KAFKA_FRAUD_GROUP=finstack-fraud
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# No financial entities are cached. "simple" avoids requiring Redis for native development.
CACHE_TYPE=simple
REDIS_HEALTH_ENABLED=false
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
# In production, set both link-logging flags=false and both SPRINGDOC flags=false.
